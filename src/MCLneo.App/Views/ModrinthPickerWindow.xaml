<Window x:Class="MCLneo.App.Views.ModrinthPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="从 Modrinth 添加模组" Width="760" Height="640"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        Loaded="Window_Loaded">
    <Border Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1" CornerRadius="18">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel>
                    <TextBlock Text="从 Modrinth 添加模组" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock x:Name="FilterText" Text="" Style="{StaticResource Muted}" Margin="0,5,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource CaptionButton}" Content="&#xE8BB;" HorizontalAlignment="Right"
                        Click="Cancel_Click"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,20,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid>
                    <TextBox x:Name="SearchBox" Height="40" Padding="11,6" FontSize="12"
                             KeyDown="SearchBox_KeyDown"/>
                    <TextBlock Text="搜索模组…" Style="{StaticResource Caption}" Margin="12,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource EmptyStringToVisibility}}"/>
                </Grid>
                <Button Grid.Column="1" Content="搜索" Style="{StaticResource PrimaryButton}" Width="70"
                        Height="40" Padding="0" Margin="8,0,0,0" Click="Search_Click"/>
            </Grid>

            <Grid Grid.Row="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ResultsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="38" Height="38" CornerRadius="10"
                                                Background="{DynamicResource AccentSoftBrush}">
                                            <TextBlock Text="{Binding Title, Converter={StaticResource Initial}}"
                                                       FontSize="15" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="11,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding Author, StringFormat='by {0}'}"
                                                       Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="添加" Style="{StaticResource SmallPrimaryButton}"
                                                Width="62" Height="30" Padding="0" Tag="{Binding}"
                                                Click="Add_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel x:Name="LoadingPanel" Visibility="Collapsed" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="正在从 Modrinth 获取模组…" FontSize="13"
                               Foreground="{DynamicResource TextBrush}"/>
                    <ProgressBar IsIndeterminate="True" Height="5" Width="240" Margin="0,12,0,0"/>
                </StackPanel>
                <TextBlock x:Name="EmptyText" Text="没有找到模组" Style="{StaticResource Muted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>

            <Grid Grid.Row="3" Margin="0,16,0,0">
                <TextBlock x:Name="StatusText" Text="" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{StaticResource SecondaryButton}" Padding="16,8"
                            MinWidth="80" Click="Cancel_Click" Margin="0,0,8,0"/>
                    <Button Content="完成" Style="{StaticResource PrimaryButton}" Padding="18,8"
                            MinWidth="100" Click="Done_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
