<Window x:Class="MCLneo.App.Views.AuthlibLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="第三方登录" Width="520" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BgBrush}" ShowInTaskbar="False"
        Loaded="Window_Loaded">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="16"
            Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource AccentSoftBrush}">
                    <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="16"
                               Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="第三方认证登录" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="authlib-injector / Yggdrasil，非微软账号"
                               Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>
            <TextBlock Grid.Row="1" Text="认证服务器地址" Style="{StaticResource SectionLabel}" Margin="1,18,0,7"/>
            <TextBox x:Name="ServerBox" Grid.Row="2" Height="40" Text="https://littleskin.cn/api/yggdrasil"
                     ToolTip="认证服务器根地址，例如 https://littleskin.cn/api/yggdrasil"/>
            <Grid Grid.Row="3" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="用户名 / 邮箱" Style="{StaticResource SectionLabel}" Margin="1,0,0,7"/>
                    <TextBox x:Name="UsernameBox" Height="40"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="密码" Style="{StaticResource SectionLabel}" Margin="1,0,0,7"/>
                    <PasswordBox x:Name="PasswordBox" Height="40" Padding="12,9"/>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="StatusText" Grid.Row="4" Text="" Style="{StaticResource Muted}" Margin="1,12,0,0"
                       TextWrapping="Wrap" MinHeight="20"/>
            <ProgressBar x:Name="Progress" Grid.Row="5" Height="5" Visibility="Collapsed" Margin="0,4,0,0"/>
            <Grid Grid.Row="6" Margin="0,18,0,0">
                <TextBlock Text="密码只用于本次登录，不会保存。AccessToken 会保存在本机配置目录。"
                           Style="{StaticResource Caption}" VerticalAlignment="Center" MaxWidth="300"
                           TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{StaticResource SecondaryButton}" Padding="16,8" Click="Cancel_Click"
                            Margin="0,0,8,0"/>
                    <Button x:Name="LoginButton" Content="登录" Style="{StaticResource PrimaryButton}" Padding="20,8"
                            Click="Login_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
