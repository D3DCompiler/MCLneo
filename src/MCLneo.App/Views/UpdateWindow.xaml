<Window x:Class="MCLneo.App.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="检查更新" Width="560" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BgBrush}" ShowInTaskbar="False"
        Loaded="Window_Loaded" TextElement.Foreground="{DynamicResource TextBrush}">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="16"
            Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <StackPanel>
                    <TextBlock Text="软件更新" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="当前版本 0.1.3 · 更新源：GitHub Releases"
                               Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource CaptionButton}" Content="&#xE8BB;" HorizontalAlignment="Right"
                        Click="Close_Click"/>
            </Grid>
            <Border Grid.Row="1" Background="{DynamicResource InsetBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="12" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock x:Name="StatusText" Text="点击检查更新，从 GitHub Releases 获取最新版本。"
                               Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="NotesText" Text="" Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Margin="0,6,0,0" Visibility="Collapsed"/>
                    <ProgressBar x:Name="Progress" Height="5" Margin="0,10,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
            <Button x:Name="CheckButton" Grid.Row="2" Content="检查更新" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right" Padding="18,9" MinWidth="120" Margin="0,18,0,0"
                    Click="Check_Click"/>
        </Grid>
    </Border>
</Window>
