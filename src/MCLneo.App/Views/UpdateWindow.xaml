<Window x:Class="MCLneo.App.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="检查更新" Width="620" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BgBrush}" ShowInTaskbar="False"
        Loaded="Window_Loaded">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="16"
            Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <StackPanel>
                    <TextBlock Text="软件更新" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="当前版本 0.1.2 · 更新包会下载到 D:\MCLneo\data\updates"
                               Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource CaptionButton}" Content="&#xE8BB;" HorizontalAlignment="Right"
                        Click="Close_Click"/>
            </Grid>
            <TextBlock Grid.Row="1" Text="更新清单 URL（支持 http/https/file 或本地路径）"
                       Style="{StaticResource SectionLabel}" Margin="0,20,0,7"/>
            <TextBox x:Name="UrlBox" Grid.Row="2" Height="40"/>
            <Border Grid.Row="3" Background="{DynamicResource InsetBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="12" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock x:Name="StatusText" Text="填写更新源后点击检查。" Style="{StaticResource Muted}"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="NotesText" Text="" Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Margin="0,6,0,0" Visibility="Collapsed"/>
                    <ProgressBar x:Name="Progress" Height="5" Margin="0,10,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
            <Grid Grid.Row="4" Margin="0,18,0,0">
                <Button Content="检查更新" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                        Padding="16,8" Click="Check_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="关闭" Style="{StaticResource GhostButton}" Padding="12,8" Click="Close_Click"
                            Margin="0,0,8,0"/>
                    <Button x:Name="InstallButton" Content="下载并安装" Style="{StaticResource PrimaryButton}"
                            Padding="17,8" IsEnabled="False" Click="Install_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
