<UserControl x:Class="MCLneo.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="740">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,2,12,30">
            <Grid Margin="2,0,0,22">
                <StackPanel>
                    <TextBlock Text="{Binding Greeting}" Style="{StaticResource H1}"/>
                    <TextBlock Text="选一个世界，检查它的加载器与存档，然后按下启动。"
                               Style="{StaticResource Muted}" Margin="1,6,0,0"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0">
                    <TextBlock Text="{Binding TodayText}" Style="{StaticResource Muted}" HorizontalAlignment="Right"/>
                    <TextBlock Text="MCLneo 0.1.2" Style="{StaticResource Caption}" HorizontalAlignment="Right"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Selected instance -->
            <Border x:Name="HeroCard" Background="{DynamicResource HeroBrush}" BorderBrush="{DynamicResource AccentBorderBrush}"
                    BorderThickness="1" CornerRadius="18" Padding="0">
                <Grid MinHeight="242">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="230"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="32,28,22,28" VerticalAlignment="Center"
                                Visibility="{Binding HasSelectedInstance, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                     Margin="0,0,8,0"/>
                            <TextBlock Text="当前游戏" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding SelectedInstance.Name}" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="34" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                   Margin="0,12,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SelectedInstance.Subtitle}" Style="{StaticResource Muted}"
                                   Margin="1,6,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Border Style="{StaticResource TagBorder}" Margin="0,0,7,0">
                                <TextBlock Text="{Binding SelectedInstance.DisplayLoader}"
                                           FontSize="10.5" Foreground="{DynamicResource MutedBrush}"/>
                            </Border>
                            <Border Style="{StaticResource TagBorder}" Margin="0,0,7,0">
                                <TextBlock Text="{Binding SelectedInstance.LastPlayed, StringFormat='上次游玩 {0:MM-dd HH:mm}'}"
                                           FontSize="10.5" Foreground="{DynamicResource MutedBrush}"/>
                            </Border>
                            <Border Style="{StaticResource TagBorder}">
                                <TextBlock Text="独立目录" FontSize="10.5" Foreground="{DynamicResource MutedBrush}"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,23,0,0">
                            <Button Content="打开目录" Style="{StaticResource SecondaryButton}" Height="44"
                                    Padding="18,0" FontSize="12" Click="OpenFolder_Click"/>
                            <Button Content="游戏管理" Style="{StaticResource GhostButton}" Height="44"
                                    Padding="14,0" Margin="6,0,0,0" FontSize="12" Click="GoInstances_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="0" Margin="32,30" VerticalAlignment="Center"
                                Visibility="{Binding HasSelectedInstance, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="你的第一个世界" FontFamily="{StaticResource DisplayFont}" FontSize="30"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="还没有 Minecraft 游戏。前往下载中心安装原版或 Fabric，几分钟后就能开始。"
                                   Style="{StaticResource Muted}" MaxWidth="470" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                            <Button Content="创建新游戏" Style="{StaticResource PrimaryButton}" Width="140" Height="44"
                                    Click="GoInstances_Click"/>
                            <Button Content="下载游戏" Style="{StaticResource SecondaryButton}" Height="44"
                                    Padding="18,0" Margin="10,0,0,0" Click="GoDownload_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Column="1" Margin="0,22,28,22">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Grid Width="158" Height="158">
                                <Border x:Name="DialPulseRing" Width="142" Height="142" CornerRadius="999"
                                        BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1"
                                        Opacity="0.8" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="DialPulseScale" ScaleX="1" ScaleY="1"/>
                                    </Border.RenderTransform>
                                </Border>
                                <Border Width="116" Height="116" CornerRadius="999"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                <Button x:Name="LaunchDialButton" Style="{StaticResource BareButton}"
                                        Width="96" Height="96" Click="Launch_Click" ToolTip="启动当前游戏"
                                        MouseEnter="LaunchDial_MouseEnter" MouseLeave="LaunchDial_MouseLeave"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Button.RenderTransform>
                                        <ScaleTransform x:Name="DialScale" ScaleX="1" ScaleY="1"/>
                                    </Button.RenderTransform>
                                    <Grid Width="96" Height="96">
                                        <Border CornerRadius="999" Background="{DynamicResource AccentGradientBrush}"/>
                                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}"
                                                   FontSize="30" Foreground="{DynamicResource AccentInkBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Margin="3,0,0,0"/>
                                    </Grid>
                                </Button>
                            </Grid>
                            <TextBlock Text="启动游戏" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"
                                       Margin="0,12,0,0"/>
                            <TextBlock Text="点击圆盘开始" Style="{StaticResource Caption}" FontSize="10"
                                       HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="315"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Grid Margin="2,0,0,12">
                        <TextBlock Text="最近游戏" Style="{StaticResource H3}"/>
                        <Button Content="查看全部" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                Padding="8,2" FontSize="11.5" Click="GoInstances_Click"/>
                    </Grid>

                    <Border Style="{StaticResource Card}" Padding="6">
                        <ItemsControl ItemsSource="{Binding Instances}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" Padding="10,8" CornerRadius="8" Background="Transparent"
                                            Cursor="Hand" MouseLeftButtonUp="InstanceCard_Click">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" CornerRadius="9"
                                                    Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name, Converter={StaticResource Initial}}"
                                                           FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}"
                                                           FontSize="10" Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" Style="{StaticResource TagBorder}" Padding="7,2"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayLoader}" FontSize="9.5"
                                                           Foreground="{DynamicResource MutedBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="22" Margin="0,2,12,0"
                            Visibility="{Binding Instances.Count, Converter={StaticResource CountToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="还没有游戏。" Style="{StaticResource Muted}"/>
                            <Button Content="现在创建一个" Style="{StaticResource GhostButton}" Padding="3,0"
                                    FontSize="12.5" Foreground="{DynamicResource AccentBrush}"
                                    Click="GoInstances_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="快速开始" Style="{StaticResource H3}" Margin="2,0,0,12"/>
                    <Border Style="{StaticResource Card}" Padding="9">
                        <StackPanel>
                            <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                                    Padding="12,12" Click="GoDownload_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Data="M12,4 V14 M8.5,10.5 L12,14 L15.5,10.5 M5,17 H19"/>
                                        </Canvas>
                                    </Viewbox>
                                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                        <TextBlock Text="下载游戏与加载器" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="原版 · Fabric · Quilt" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="" FontSize="18" Foreground="{DynamicResource FaintBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                                    Padding="12,12" Click="GoMods_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Stroke="{DynamicResource BlueBrush}" StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Data="M5,5 H11 V11 H5 Z M13,5 H19 V11 H13 Z M5,13 H11 V19 H5 Z M13,13 H19 V19 H13 Z"/>
                                        </Canvas>
                                    </Viewbox>
                                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                        <TextBlock Text="安装模组" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="从 Modrinth 搜索" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="" FontSize="18" Foreground="{DynamicResource FaintBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                                    Padding="12,12" Click="GoSaves_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Stroke="{DynamicResource WarningBrush}" StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Data="M5,5 H17 L19,7 V19 H5 Z M8,5 V10 H16 V5 M8,13 H16 V19 H8 Z"/>
                                        </Canvas>
                                    </Viewbox>
                                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                        <TextBlock Text="导出存档" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="备份为 zip 文件" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="" FontSize="18" Foreground="{DynamicResource FaintBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                                    Padding="12,12" Click="GoRoom_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Data="M8,11 A3,3 0 1 0 8,5 A3,3 0 1 0 8,11 M3,19 C3,15 5,13 8,13 C11,13 13,15 13,19 M15.5,9 A2.5,2.5 0 1 0 15.5,4 M15,13 C18,13 20,15 20,18"/>
                                        </Canvas>
                                    </Viewbox>
                                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                        <TextBlock Text="和朋友联机" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="创建或加入房间" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="" FontSize="18" Foreground="{DynamicResource FaintBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="本机环境" Style="{StaticResource SectionLabel}"/>
                                <TextBlock Text="{Binding JavaRuntimes.Count, StringFormat='已检测到 {0} 个 Java 运行时'}"
                                           Style="{StaticResource Muted}" Margin="0,7,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="&#xE950;" FontFamily="{StaticResource IconFont}" FontSize="22"
                                       Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
