<Window x:Class="MCLneo.App.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MCLneo" Width="460" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BgBrush}" ShowInTaskbar="False"
        KeyDown="Window_KeyDown" MouseLeftButtonDown="Window_MouseLeftButtonDown" Loaded="Window_Loaded">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="16"
            Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border x:Name="IconBadge" Width="36" Height="36" CornerRadius="11" Background="{DynamicResource AccentSoftBrush}">
                    <TextBlock x:Name="IconGlyph" Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="16"
                               Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TitleText" Text="提示" FontSize="17" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
            <TextBlock x:Name="MessageText" Grid.Row="1" Text="" Style="{StaticResource Body}" Margin="0,18,0,0"
                       TextWrapping="Wrap" LineHeight="21"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button x:Name="CancelButton" Content="取消" Style="{StaticResource SecondaryButton}" Padding="17,8"
                        MinWidth="78" Click="Cancel_Click" Margin="0,0,8,0"/>
                <Button x:Name="ConfirmButton" Content="确定" Style="{StaticResource PrimaryButton}" Padding="17,8"
                        MinWidth="92" Click="Confirm_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
