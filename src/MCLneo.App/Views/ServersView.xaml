<UserControl x:Class="MCLneo.App.Views.ServersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="740">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="服务器" Style="{StaticResource H2}"/>
                <TextBlock Text="管理游戏的 servers.dat，并直接启动游戏连接服务器。"
                           Style="{StaticResource Muted}" Margin="1,6,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="目标游戏" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                <ComboBox x:Name="InstanceBox" Width="230" Height="38" ItemsSource="{Binding Instances}"
                          SelectedItem="{Binding SelectedInstance, Mode=TwoWay}"
                          SelectionChanged="InstanceBox_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="{Binding Subtitle}" FontSize="9" Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="+ 添加服务器" Style="{StaticResource PrimaryButton}" Padding="14,8" Margin="8,0,0,0"
                        FontSize="12" Click="Add_Click"/>
                <Button Content="刷新" Style="{StaticResource SecondaryButton}" Padding="12,8" Margin="8,0,0,0"
                        FontSize="11" Click="Refresh_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <ListBox x:Name="ServerList">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardHover}" Padding="17,13" Margin="0,0,0,9" CornerRadius="13">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="11" Background="{DynamicResource BlueSoftBrush}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                               Foreground="{DynamicResource BlueBrush}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="11,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Ip}" Style="{StaticResource Muted}" FontSize="11"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="启动并连接" Style="{StaticResource SmallPrimaryButton}" Width="92"
                                            Height="32" Padding="0" Tag="{Binding}" Click="Connect_Click"/>
                                    <Button Content="编辑" Style="{StaticResource SmallButton}" Width="54" Height="32"
                                            Padding="0" Margin="7,0,0,0" Tag="{Binding}" Click="Edit_Click"/>
                                    <Button Content="&#xE74D;" Style="{StaticResource SmallButton}" Width="32" Height="32"
                                            Padding="0" Margin="7,0,0,0" FontFamily="{StaticResource IconFont}"
                                            Foreground="{DynamicResource DangerBrush}" Tag="{Binding}" Click="Delete_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border x:Name="EmptyPanel" Style="{StaticResource Card}" Padding="30" VerticalAlignment="Top"
                    Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" Margin="0,40">
                    <Border Width="58" Height="58" CornerRadius="16" Background="{DynamicResource SurfaceAltBrush}">
                        <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="23"
                                   Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="还没有服务器" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}" Margin="0,14,0,0"/>
                    <TextBlock Text="添加一个服务器地址，之后可以直接启动并加入。"
                               Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    <Button Content="添加服务器" Style="{StaticResource PrimaryButton}" Width="120" Height="36"
                            Margin="0,15,0,0" Click="Add_Click"/>
                </StackPanel>
            </Border>

            <Border x:Name="NoInstancePanel" Style="{StaticResource Card}" Padding="30" VerticalAlignment="Top"
                    Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" Margin="0,50">
                    <TextBlock Text="先选择一个游戏" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="服务器列表保存在游戏的 servers.dat 中。"
                               Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="2,11,0,0">
            <TextBlock x:Name="HintText" Text="" Style="{StaticResource Caption}"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="地址格式：example.com 或 example.com:25565" Style="{StaticResource Caption}"
                       HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</UserControl>
