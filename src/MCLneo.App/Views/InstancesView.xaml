<UserControl x:Class="MCLneo.App.Views.InstancesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="740">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="实例库" Style="{StaticResource H2}"/>
                <StackPanel Orientation="Horizontal" Margin="1,5,0,0">
                    <TextBlock Text="{Binding Instances.Count, StringFormat='共 {0} 个实例'}" Style="{StaticResource Muted}"/>
                    <TextBlock Text="  ·  每个实例拥有独立的模组、存档与配置" Style="{StaticResource Muted}"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Grid Width="190">
                    <TextBox x:Name="SearchBox" Height="36" Padding="11,7" FontSize="12"
                             TextChanged="SearchBox_TextChanged" ToolTip="按名称或版本搜索实例"/>
                    <TextBlock Text="搜索实例…" Style="{StaticResource Caption}" Margin="12,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource EmptyStringToVisibility}}"/>
                </Grid>
                <Button Content="刷新" Style="{StaticResource SecondaryButton}" Width="54" Height="36"
                        Margin="8,0,0,0" FontSize="11" Padding="0" ToolTip="刷新实例列表" Click="Refresh_Click"/>
                <Button Content="导入实例" Style="{StaticResource SecondaryButton}" Padding="13,8"
                        Margin="8,0,0,0" FontSize="12" Click="Import_Click"/>
                <Button Content="导入已有版本" Style="{StaticResource SecondaryButton}" Padding="13,8"
                        Margin="8,0,0,0" FontSize="12" Click="ImportExternal_Click"/>
                <Button Content="+  新建实例" Style="{StaticResource PrimaryButton}" Padding="15,8"
                        Margin="8,0,0,0" FontSize="12" Click="Create_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <ListBox x:Name="InstanceList" ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance, Mode=TwoWay}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,10" Padding="17" CornerRadius="15"
                                MouseLeftButtonDown="InstanceCard_DoubleClick">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                     Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="Background" Value="{DynamicResource NavActiveBrush}"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="62"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="50" Height="50" CornerRadius="14" Background="{DynamicResource AccentSoftBrush}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name, Converter={StaticResource Initial}}" FontSize="21"
                                               FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,1,16,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="15.5" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                                        <Border Style="{StaticResource TagBorder}" Margin="10,0,0,0" Padding="8,2"
                                                Visibility="{Binding IsImported, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="已导入" FontSize="9.5" Foreground="{DynamicResource WarningBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                        <TextBlock Text="{Binding Id, StringFormat='目录 · {0}'}" Style="{StaticResource Caption}"
                                                   Margin="0,0,14,0"/>
                                        <TextBlock Text="{Binding LastPlayed, StringFormat='上次游玩 {0:yyyy-MM-dd HH:mm}'}"
                                                   Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="启动" Style="{StaticResource SmallPrimaryButton}" Width="66"
                                            Height="34" Padding="0" Click="Launch_Click" Tag="{Binding}"/>
                                    <Button Content="目录" Style="{StaticResource SmallButton}" Width="58"
                                            Height="34" Padding="0" Margin="7,0,0,0" Click="OpenFolder_Click"
                                            Tag="{Binding}"/>
                                    <Button Content="导出" Style="{StaticResource SmallButton}" Width="58"
                                            Height="34" Padding="0" Margin="7,0,0,0" Click="Export_Click"
                                            Tag="{Binding}"/>
                                    <Button Content="修复" Style="{StaticResource SmallButton}" Width="52"
                                            Height="34" Padding="0" Margin="7,0,0,0" Click="Repair_Click"
                                            Tag="{Binding}"/>
                                    <Button Content="日志" Style="{StaticResource SmallButton}" Width="52"
                                            Height="34" Padding="0" Margin="7,0,0,0" Click="Logs_Click"
                                            Tag="{Binding}"/>
                                    <Button Content="&#xE70F;" Style="{StaticResource SmallButton}" Width="36"
                                            Height="34" Padding="0" Margin="7,0,0,0" FontFamily="{StaticResource IconFont}"
                                            ToolTip="重命名" Click="Rename_Click" Tag="{Binding}"/>
                                    <Button Content="&#xE74D;" Style="{StaticResource SmallButton}" Width="36"
                                            Height="34" Padding="0" Margin="7,0,0,0" FontFamily="{StaticResource IconFont}"
                                            Foreground="{DynamicResource DangerBrush}" ToolTip="删除"
                                            Click="Delete_Click" Tag="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Style="{StaticResource Card}" VerticalAlignment="Top" Padding="32" Margin="0,4,0,0"
                    Visibility="{Binding Instances.Count, Converter={StaticResource CountToVisibility}}">
                <StackPanel HorizontalAlignment="Center" Margin="0,45,0,45">
                    <Border Width="64" Height="64" CornerRadius="18" Background="{DynamicResource SurfaceAltBrush}">
                        <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                   Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="实例库还是空的" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}" Margin="0,16,0,0"/>
                    <TextBlock Text="安装一个原版或 Fabric 实例，MCLneo 会为它准备独立的模组、存档与配置目录。"
                               Style="{StaticResource Muted}" HorizontalAlignment="Center" MaxWidth="440"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,7,0,0"/>
                    <Button Content="创建第一个实例" Style="{StaticResource PrimaryButton}" Width="160" Height="42"
                            Margin="0,20,0,0" Click="Create_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="1,13,0,0">
            <TextBlock Text="提示：把游戏目录指向已有的 .minecraft，MCLneo 会自动识别其中的版本。"
                       Style="{StaticResource Caption}"/>
            <TextBlock Text="双击实例卡片也可以直接启动" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
        </Grid>

        <Grid Grid.RowSpan="4" x:Name="BusyOverlay" Visibility="Collapsed" Background="{DynamicResource OverlayBrush}">
            <Border Width="390" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="24" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="BusyTitle" Text="正在处理…" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="BusyDetail" Text="" Style="{StaticResource Muted}" Margin="0,6,0,14"
                               TextWrapping="Wrap"/>
                    <ProgressBar x:Name="BusyProgress" Height="6" Minimum="0" Maximum="1"/>
                    <TextBlock x:Name="BusyPercent" Text="0%" Style="{StaticResource Caption}" Margin="0,7,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
