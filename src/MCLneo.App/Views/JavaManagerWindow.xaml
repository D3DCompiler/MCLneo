<Window x:Class="MCLneo.App.Views.JavaManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Java 运行时管理" Width="760" Height="620" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BgBrush}" ShowInTaskbar="False"
        Loaded="Window_Loaded">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                    Background="{DynamicResource TitleBarBrush}" CornerRadius="16,16,0,0" Padding="22,0,10,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Java 运行时管理" FontSize="14" FontWeight="SemiBold"/>
                        <Border Style="{StaticResource AccentTagBorder}" Margin="10,0,0,0" Padding="8,2">
                            <TextBlock Text="ADOPTIUM" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                    </StackPanel>
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE8BB;" HorizontalAlignment="Right"
                            Click="Close_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="22,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Content="下载 Java 8" Style="{StaticResource SecondaryButton}" Padding="13,7"
                            Tag="8" Click="Download_Click"/>
                    <Button Content="下载 Java 17" Style="{StaticResource SecondaryButton}" Padding="13,7"
                            Margin="8,0,0,0" Tag="17" Click="Download_Click"/>
                    <Button Content="下载 Java 21" Style="{StaticResource PrimaryButton}" Padding="13,7"
                            Margin="8,0,0,0" Tag="21" Click="Download_Click"/>
                    <Button Content="重新扫描" Style="{StaticResource GhostButton}" Padding="12,7"
                            Margin="8,0,0,0" Click="Refresh_Click"/>
                </StackPanel>
                <ListBox x:Name="RuntimeList" Grid.Row="1" Margin="0,14,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="14,11" Margin="0,0,0,8" CornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource AccentSoftBrush}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="J" FontSize="16" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="11,0,12,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Display}" FontSize="12.5" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ExecutablePath}" Style="{StaticResource Caption}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Style="{StaticResource TagBorder}" Margin="0,0,8,0" Padding="8,3">
                                            <TextBlock Text="已检测" FontSize="9.5"
                                                       Foreground="{DynamicResource MutedBrush}"/>
                                        </Border>
                                        <Button Content="删除" Style="{StaticResource SmallButton}" Width="52"
                                                Height="30" Padding="0" Tag="{Binding}" Click="Delete_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                    Padding="22,14">
                <Grid>
                    <TextBlock x:Name="StatusText" Text="正在扫描 Java…" Style="{StaticResource Muted}"
                               VerticalAlignment="Center"/>
                    <ProgressBar x:Name="Progress" Width="220" Height="5" HorizontalAlignment="Right"
                                 VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
