<UserControl x:Class="MCLneo.App.Views.RoomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="740" TextElement.Foreground="{DynamicResource TextBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,12,24">
            <Grid Margin="2,0,0,18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="联机" Style="{StaticResource H2}"/>
                        <Border Style="{StaticResource AccentTagBorder}" Margin="10,1,0,0" Padding="8,3">
                            <TextBlock Text="IPV6 优先 · EASYTIER 回退" FontSize="8.5" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="自动优先 IPv6 直连；连不上时自动使用 EasyTier 房间。"
                               Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{Binding Ipv6Status}" Style="{StaticResource Caption}" FontSize="10.5"
                                   TextWrapping="Wrap" MaxWidth="660" VerticalAlignment="Center"/>
                        <Button Content="检测 IPv6" Style="{StaticResource SmallButton}" Padding="10,5"
                                Margin="10,0,0,0" Click="CheckIpv6_Click"/>
                    </StackPanel>
                </StackPanel>
                <Border Style="{StaticResource TagBorder}" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Padding="11,5">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                 Margin="0,0,7,0"/>
                        <TextBlock Text="{Binding ConnectionRoleText, TargetNullValue='未连接'}" FontSize="10.5"
                                   Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="在线玩家" Style="{StaticResource H3}"/>
                            <Border Style="{StaticResource TagBorder}" Padding="7,2" Margin="8,0,0,0">
                                <TextBlock Text="{Binding RoomPlayers.Count, StringFormat={}{0} 人}" FontSize="9.5"
                                           Foreground="{DynamicResource MutedBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding RoomPlayersStatus}" Style="{StaticResource Muted}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,5,0,0"/>
                        <ItemsControl ItemsSource="{Binding RoomPlayers}" Margin="0,9,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TagBorder}" Padding="8,3" Margin="0,0,6,5">
                                        <TextBlock Text="{Binding}" FontSize="10.5"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Button Grid.Column="1" Content="刷新" Style="{StaticResource SmallButton}" Width="60" Height="30"
                            VerticalAlignment="Top" Click="RefreshPlayers_Click"
                            IsEnabled="{Binding IsRoomPlayersBusy, Converter={StaticResource InverseBool}}"/>
                </Grid>
            </Border>

            <Border x:Name="AdminWarning" Visibility="Collapsed" Background="{DynamicResource WarningSoftBrush}"
                    BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" CornerRadius="12"
                    Padding="14,11" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="EasyTier 回退需要管理员权限" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource WarningBrush}"/>
                        <TextBlock Text="IPv6 直连不需要管理员权限；只有自动回退到 EasyTier 时才需要创建 TUN 虚拟网卡。"
                                   Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,3,14,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="以管理员身份重启" Style="{StaticResource SecondaryButton}"
                            Padding="13,7" FontSize="11" VerticalAlignment="Center" Click="Elevate_Click"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Padding="22">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="创建 / 加入联机" Style="{StaticResource H3}"/>
                            <TextBlock Text="先选联机方式；自动模式优先 IPv6，失败或没有公网 IPv6 时使用 EasyTier。"
                                       Style="{StaticResource Muted}" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="联机方式" Style="{StaticResource SectionLabel}" Margin="1,0,0,5"/>
                            <ComboBox x:Name="ConnectionModeBox" Width="150" Height="36" SelectedIndex="0">
                                <ComboBoxItem Content="自动选择"/>
                                <ComboBoxItem Content="IPv6 直连"/>
                                <ComboBoxItem Content="EasyTier 房间"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,18,0,0"
                          Visibility="{Binding IsMultiplayerActive, Converter={StaticResource InverseBoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="创建联机" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="在单人游戏中按 Esc，选择“对局域网开放”，把聊天栏端口填在下面。"
                                       Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            <TextBlock Text="局域网端口" Style="{StaticResource SectionLabel}" Margin="1,14,0,6"/>
                            <TextBox x:Name="HostPortBox" Height="40" FontSize="14" MaxLength="5"
                                     ToolTip="例如 54321"/>
                            <Button x:Name="HostButton" Content="创建联机" Style="{StaticResource PrimaryButton}"
                                    Height="40" Margin="0,10,0,0" Click="Host_Click"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="加入联机" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="自动识别 IPv6 地址或 MCLN1 邀请码；EasyTier 回退时使用邀请码。"
                                       Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            <TextBlock Text="IPv6 地址 / 邀请码" Style="{StaticResource SectionLabel}" Margin="1,14,0,6"/>
                            <TextBox x:Name="JoinInputBox" Height="76" FontSize="11" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     ToolTip="粘贴 [IPv6]:端口 或 MCLN1: 邀请码"/>
                            <Button x:Name="JoinButton" Content="加入联机" Style="{StaticResource SecondaryButton}"
                                    Height="40" Margin="0,10,0,0" Click="Join_Click"/>
                        </StackPanel>
                    </Grid>

                    <ProgressBar Value="{Binding RoomProgress, Mode=OneWay}" Minimum="0" Maximum="1" Height="5"
                                 Margin="0,12,0,0"
                                 Visibility="{Binding IsRoomBusy, Converter={StaticResource BoolToVisibility}}"/>
                    <ProgressBar Value="{Binding DirectProgress, Mode=OneWay}" Minimum="0" Maximum="1" Height="5"
                                 Margin="0,6,0,0"
                                 Visibility="{Binding IsDirectBusy, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="{Binding RoomStatus}" Style="{StaticResource Muted}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,7,0,0"/>
                    <TextBlock Text="{Binding DirectStatus}" Style="{StaticResource Muted}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <!-- Active EasyTier room -->
            <Border Visibility="{Binding IsRoomActive, Converter={StaticResource BoolToVisibility}}"
                    Style="{StaticResource Card}" Padding="0" Background="{DynamicResource HeroBrush}"
                    BorderBrush="{DynamicResource AccentBorderBrush}" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="250"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="28,24" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource AccentTagBorder}" Padding="9,3">
                                <TextBlock Text="EasyTier" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                            <TextBlock Text="{Binding RoomStatus}" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                       Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding RoomInviteCode, Converter={StaticResource NullToVisibility}}">
                            <TextBlock Text="把邀请码发给朋友" FontSize="19" FontWeight="Bold" Margin="0,16,0,0"/>
                            <TextBlock Text="朋友在联机页面粘贴邀请码即可加入。" Style="{StaticResource Muted}" Margin="0,5,0,0"/>
                            <Border Background="{DynamicResource OverlayBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,12,0,0">
                                <TextBox Text="{Binding RoomInviteCode, Mode=OneWay}" IsReadOnly="True" Background="Transparent"
                                         BorderThickness="0" Padding="0" FontFamily="{StaticResource MonoFont}"
                                         FontSize="10.5" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         MaxHeight="60"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Visibility="{Binding RoomConnectAddress, Converter={StaticResource NullToVisibility}}">
                            <TextBlock Text="在多人游戏中连接" FontSize="17" FontWeight="Bold" Margin="0,14,0,0"/>
                            <TextBlock Text="{Binding RoomConnectAddress}" FontFamily="{StaticResource MonoFont}"
                                       FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Content="复制邀请码" Style="{StaticResource PrimaryButton}" Padding="15,8"
                                    Click="CopyInvite_Click"
                                    Visibility="{Binding RoomInviteCode, Converter={StaticResource NullToVisibility}}"/>
                            <Button Content="复制连接地址" Style="{StaticResource PrimaryButton}" Padding="15,8"
                                    Margin="8,0,0,0" Click="CopyAddress_Click"
                                    Visibility="{Binding RoomConnectAddress, Converter={StaticResource NullToVisibility}}"/>
                            <Button Content="联机日志" Style="{StaticResource SecondaryButton}" Padding="13,8"
                                    Margin="8,0,0,0" Click="OpenLog_Click"/>
                            <Button Content="离开房间" Style="{StaticResource DangerButton}" Padding="13,8"
                                    Margin="8,0,0,0" Click="Stop_Click"/>
                        </StackPanel>
                    </StackPanel>
                    <Grid Grid.Column="1" IsHitTestVisible="False">
                        <Canvas Width="110" Height="110" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="98" Height="98" Stroke="{DynamicResource AccentBorderBrush}" StrokeThickness="1" Opacity="0.7"/>
                            <Ellipse Width="62" Height="62" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1" Opacity="0.45"/>
                            <Ellipse Width="9" Height="9" Fill="{DynamicResource AccentBrush}"/>
                        </Canvas>
                    </Grid>
                </Grid>
            </Border>

            <!-- Active IPv6 direct -->
            <Border Visibility="{Binding IsDirectActive, Converter={StaticResource BoolToVisibility}}"
                    Style="{StaticResource Card}" Padding="24" Margin="0,14,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource AccentTagBorder}" Padding="9,3">
                            <TextBlock Text="{Binding DirectRoleText}" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                        <TextBlock Text="IPv6 直连已开启" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                   Margin="10,0,0,0"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding DirectShareAddress, Converter={StaticResource NullToVisibility}}">
                        <TextBlock Text="把这个地址发给朋友" Style="{StaticResource SectionLabel}" Margin="0,14,0,5"/>
                        <TextBlock Text="{Binding DirectShareAddress}" FontFamily="{StaticResource MonoFont}"
                                   FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding DirectConnectAddress, Converter={StaticResource NullToVisibility}}">
                        <TextBlock Text="在多人游戏中连接" Style="{StaticResource SectionLabel}" Margin="0,14,0,5"/>
                        <TextBlock Text="{Binding DirectConnectAddress}" FontFamily="{StaticResource MonoFont}"
                                   FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="复制地址" Style="{StaticResource PrimaryButton}" Padding="15,8"
                                Click="CopyDirect_Click"/>
                        <Button Content="断开直连" Style="{StaticResource DangerButton}" Padding="15,8"
                                Margin="8,0,0,0" Click="StopDirect_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="20" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="联机说明" Style="{StaticResource H3}"/>
                    <TextBlock Text="1. 房主先在单人游戏中按 Esc，选择“对局域网开放”，记下端口。"
                               Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="2. 自动模式：检测到公网 IPv6 时创建 IPv6 直连；否则创建 EasyTier 房间。"
                               Style="{StaticResource Muted}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="3. IPv6 直连需要双方都有公网 IPv6，并放行防火墙入站；EasyTier 回退需要管理员权限。"
                               Style="{StaticResource Muted}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="4. 加入方的 Minecraft 连接地址会显示在创建/加入联机后出现的卡片中。"
                               Style="{StaticResource Muted}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
