<Window x:Class="MCLneo.App.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MCLneo" Width="470" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BgBrush}" ShowInTaskbar="False"
        KeyDown="Window_KeyDown" MouseLeftButtonDown="Window_MouseLeftButtonDown" Loaded="Window_Loaded">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="16"
            Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" Text="输入" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="PromptText" Grid.Row="1" Text="" Style="{StaticResource Muted}" Margin="0,8,0,0"
                       TextWrapping="Wrap"/>
            <TextBox x:Name="InputBox" Grid.Row="2" Height="42" Margin="0,16,0,0" FontSize="14"/>
            <TextBlock x:Name="ErrorText" Grid.Row="3" Text="" FontSize="11.5" Foreground="{DynamicResource DangerBrush}"
                       Margin="1,7,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="取消" Style="{StaticResource SecondaryButton}" Padding="17,8" MinWidth="78"
                        Click="Cancel_Click" Margin="0,0,8,0"/>
                <Button Content="确定" Style="{StaticResource PrimaryButton}" Padding="17,8" MinWidth="92"
                        Click="Confirm_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
