<UserControl x:Class="MCLneo.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="740">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,12,28">
            <Grid Margin="2,0,0,20">
                <StackPanel>
                    <TextBlock Text="设置" Style="{StaticResource H2}"/>
                    <TextBlock Text="调整启动器行为。修改游戏目录后，游戏列表会自动重新扫描。"
                               Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                </StackPanel>
                <Button Content="保存设置" Style="{StaticResource PrimaryButton}" Padding="20,9"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Click="Save_Click"/>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="22">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="账户" Style="{StaticResource H3}"/>
                        <Border Style="{StaticResource TagBorder}" Margin="9,0,0,0" Padding="7,2">
                            <TextBlock Text="离线模式" FontSize="9" Foreground="{DynamicResource WarningBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="玩家名用于本地游戏和局域网联机。支持 authlib-injector 第三方账号；Microsoft 正版登录不在此版本范围内。"
                               Style="{StaticResource Muted}" Margin="0,5,0,14"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="64"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="玩家名" Style="{StaticResource SectionLabel}" Margin="1,0,0,7"/>
                            <TextBox x:Name="PlayerNameBox" Height="40" MaxLength="16" TextChanged="PlayerName_TextChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="UUID" Style="{StaticResource SectionLabel}" Margin="1,0,0,7"/>
                            <Border Style="{StaticResource Inset}" Height="40">
                                <TextBlock x:Name="UuidText" Text="" FontFamily="{StaticResource MonoFont}"
                                           FontSize="10.5" Foreground="{DynamicResource MutedBrush}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Border>
                        </StackPanel>
                        <Border Grid.Column="4" Width="64" Height="64" CornerRadius="12" Background="{DynamicResource InsetBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True"
                                ToolTip="皮肤预览">
                            <Image x:Name="SkinImage" Stretch="UniformToFill"/>
                        </Border>
                    </Grid>
                    <Grid Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="AccountStatusText" Text="当前：离线账户" Style="{StaticResource Muted}"
                                       VerticalAlignment="Center"/>
                            <Border x:Name="ThirdPartyBadge" Style="{StaticResource AccentTagBorder}" Margin="9,0,0,0"
                                    Padding="7,2" Visibility="Collapsed">
                                <TextBlock Text="AUTHLIB" FontSize="8.5" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="第三方登录" Style="{StaticResource SecondaryButton}" Padding="13,7"
                                    FontSize="11" Click="AuthlibLogin_Click"/>
                            <Button x:Name="SkinSiteButton" Content="皮肤站" Style="{StaticResource GhostButton}"
                                    Padding="11,7" FontSize="11" Margin="6,0,0,0" Click="SkinSite_Click"
                                    Visibility="Collapsed"/>
                            <Button x:Name="LogoutAuthlibButton" Content="退出第三方" Style="{StaticResource GhostButton}"
                                    Padding="11,7" FontSize="11" Margin="6,0,0,0" Click="AuthlibLogout_Click"
                                    Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="22" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="游戏与 Java" Style="{StaticResource H3}"/>
                    <TextBlock Text="游戏文件会存放在这里；每个游戏仍拥有独立的模组、存档与配置目录。"
                               Style="{StaticResource Muted}" Margin="0,5,0,16"/>

                    <TextBlock Text="游戏目录" Style="{StaticResource SectionLabel}" Margin="1,0,0,7"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="GameRootBox" Height="40"/>
                        <Button Grid.Column="1" Content="浏览" Style="{StaticResource SecondaryButton}"
                                Padding="14,7" Margin="8,0,0,0" Click="BrowseGameRoot_Click"/>
                        <Button Grid.Column="2" Content="打开" Style="{StaticResource GhostButton}"
                                Padding="12,7" Margin="4,0,0,0" Click="OpenGameRoot_Click"/>
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Java 运行时" Style="{StaticResource SectionLabel}" Margin="1,0,0,7"/>
                            <ComboBox x:Name="JavaBox" Height="40" DisplayMemberPath="Display"/>
                            <TextBlock Text="留空会自动检测；启动时如缺少所需版本，会下载 JRE。"
                                       Style="{StaticResource Caption}" Margin="2,6,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="内存分配" Style="{StaticResource SectionLabel}" Margin="1,0,0,7"/>
                            <ComboBox x:Name="MemoryBox" Height="40"/>
                            <TextBlock Text="建议 4–8 GB。超过物理内存会导致卡顿。"
                                       Style="{StaticResource Caption}" Margin="2,6,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="下载源" Style="{StaticResource SectionLabel}" Margin="1,0,0,7"/>
                            <ComboBox x:Name="SourceBox" Height="40"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="并行下载数" Style="{StaticResource SectionLabel}" Margin="1,0,0,7"/>
                            <ComboBox x:Name="ThreadBox" Height="40"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="重新检测 Java" Style="{StaticResource SecondaryButton}" Padding="15,8"
                                Click="RescanJava_Click"/>
                        <Button Content="管理 Java 运行时" Style="{StaticResource SecondaryButton}" Padding="15,8"
                                Margin="6,0,0,0" Click="ManageJava_Click"/>
                        <Button Content="浏览 Java 可执行文件" Style="{StaticResource GhostButton}" Padding="12,8"
                                Margin="6,0,0,0" Click="BrowseJava_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="22" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="界面与体验" Style="{StaticResource H3}"/>
                    <TextBlock Text="浅色与深色模式使用同一套版式，主题色会随模式自动调整；保存后立即应用。"
                               Style="{StaticResource Muted}" Margin="0,5,0,14"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="1.15*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="外观模式" Style="{StaticResource SectionLabel}" Margin="1,0,0,7"/>
                            <ComboBox x:Name="ThemeModeBox" Height="40"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="主题色" Style="{StaticResource SectionLabel}" Margin="1,0,0,7"/>
                            <ComboBox x:Name="ThemeBox" Height="40"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="帮助与更新" Style="{StaticResource SectionLabel}" Margin="1,0,0,7"/>
                            <Button Content="打开帮助与快捷键" Style="{StaticResource SecondaryButton}" Height="40"
                                    Click="Help_Click"/>
                            <Button Content="检查软件更新" Style="{StaticResource GhostButton}" Height="34"
                                    Margin="0,7,0,0" FontSize="11" Click="Update_Click"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="22" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="联机模块" Style="{StaticResource H3}"/>
                    <TextBlock Text="联机房间使用 EasyTier 组建私有虚拟网络。首次创建或加入房间时会自动下载。"
                               Style="{StaticResource Muted}" Margin="0,5,0,16"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="自定义中继节点（可选）" Style="{StaticResource SectionLabel}" Margin="1,0,0,7"/>
                            <TextBox x:Name="PeerBox" Height="40" ToolTip="例如 tcp://public.easytier.top:11010"/>
                            <TextBlock Text="留空会从 EasyTier 公共节点列表中自动选择。"
                                       Style="{StaticResource Caption}" Margin="2,6,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="EasyTier Core 路径（可选）" Style="{StaticResource SectionLabel}" Margin="1,0,0,7"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CorePathBox" Height="40"/>
                                <Button Grid.Column="1" Content="浏览" Style="{StaticResource SecondaryButton}"
                                        Padding="12,7" Margin="7,0,0,0" Click="BrowseCore_Click"/>
                            </Grid>
                            <TextBlock Text="如果已经手动安装，可直接指定 easytier-core.exe。"
                                       Style="{StaticResource Caption}" Margin="2,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="22" Margin="0,14,0,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="关于 MCLneo" Style="{StaticResource H3}"/>
                        <TextBlock Text="一个独立的 Minecraft 启动器，目标是对齐 PCL2 的核心工作流，同时保持代码与数据可迁移。"
                                   Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0" MaxWidth="560"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Border Style="{StaticResource TagBorder}">
                                <TextBlock Text="0.1.2 · PREVIEW" FontSize="9.5" Foreground="{DynamicResource MutedBrush}"/>
                            </Border>
                            <Border Style="{StaticResource TagBorder}" Margin="6,0,0,0">
                                <TextBlock Text=".NET 10 · WPF" FontSize="9.5" Foreground="{DynamicResource MutedBrush}"/>
                            </Border>
                            <Border Style="{StaticResource TagBorder}" Margin="6,0,0,0">
                                <TextBlock Text="Windows x64" FontSize="9.5" Foreground="{DynamicResource MutedBrush}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="打开数据目录" Style="{StaticResource SecondaryButton}" Padding="14,8"
                                Click="OpenDataFolder_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="MCLneo 不隶属于 Mojang Studios 或 Microsoft。Minecraft 是 Mojang Studios 的商标。"
                       Style="{StaticResource Caption}" Margin="2,14,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
