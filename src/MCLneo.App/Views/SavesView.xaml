<UserControl x:Class="MCLneo.App.Views.SavesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="740">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="存档管理" Style="{StaticResource H2}"/>
                <TextBlock Text="把世界导出成 zip 备份，或者从备份中恢复。存档跟随游戏存放。"
                           Style="{StaticResource Muted}" Margin="1,6,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="目标游戏" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                <ComboBox x:Name="InstanceBox" Width="230" Height="38" ItemsSource="{Binding Instances}"
                          SelectedItem="{Binding SelectedInstance, Mode=TwoWay}"
                          SelectionChanged="InstanceBox_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="{Binding Subtitle}" FontSize="9" Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="导入存档" Style="{StaticResource SecondaryButton}" Padding="14,8" Margin="8,0,0,0"
                        FontSize="12" Click="Import_Click"/>
                <Button Content="刷新" Style="{StaticResource SecondaryButton}" Width="54" Height="38"
                        Margin="8,0,0,0" FontSize="11" Padding="0" ToolTip="刷新存档" Click="Refresh_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl x:Name="WorldList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardHover}" Width="310" Height="205" Margin="0,0,12,12"
                                        Padding="0" CornerRadius="15" ClipToBounds="True">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="86"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="15,15,0,0">
                                            <Grid>
                                                <Border Background="{DynamicResource AccentSoftBrush}" Opacity="0.7"/>
                                                <Image Source="{Binding IconPath}" Stretch="UniformToFill" Opacity="0.92"/>
                                                <Border Background="{DynamicResource OverlayBrush}" VerticalAlignment="Bottom" Height="34"/>
                                                <StackPanel Orientation="Horizontal" Margin="14,0,0,9" VerticalAlignment="Bottom">
                                                    <Border Style="{StaticResource AccentTagBorder}" Padding="7,2" Background="{DynamicResource AccentSoftBrush}">
                                                        <TextBlock Text="{Binding GameModeText}" FontSize="9" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AccentBrush}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Version}" Style="{StaticResource Caption}"
                                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Grid Grid.Row="1" Margin="14,10,14,12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <TextBlock Text="{Binding LastPlayedText}" Style="{StaticResource Caption}"/>
                                                    <TextBlock Text="  ·  " Style="{StaticResource Caption}"/>
                                                    <TextBlock Text="{Binding SizeText}" Style="{StaticResource Caption}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="导出" Style="{StaticResource SmallButton}" Width="50"
                                                            Height="28" Padding="0" Tag="{Binding}" Click="Export_Click"/>
                                                    <Button Content="备份" Style="{StaticResource SmallButton}" Width="50"
                                                            Height="28" Padding="0" Margin="6,0,0,0" Tag="{Binding}"
                                                            Click="Backup_Click"/>
                                                    <Button Content="目录" Style="{StaticResource SmallButton}" Width="50"
                                                            Height="28" Padding="0" Margin="6,0,0,0" Tag="{Binding}"
                                                            Click="OpenFolder_Click"/>
                                                    <Button Content="包" Style="{StaticResource SmallButton}" Width="30"
                                                            Height="28" Padding="0" Margin="6,0,0,0" Tag="{Binding}"
                                                            ToolTip="打开数据包目录" Click="Datapacks_Click"/>
                                                </StackPanel>
                                                <Button Content="&#xE74D;" Style="{StaticResource SmallGhostButton}" Width="30"
                                                        Height="28" Padding="0" HorizontalAlignment="Right"
                                                        FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource DangerBrush}"
                                                        Tag="{Binding}" Click="Delete_Click"/>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border x:Name="EmptyPanel" Style="{StaticResource Card}" Padding="34" Margin="0,20,12,0"
                            Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" Margin="0,40">
                            <Border Width="60" Height="60" CornerRadius="17" Background="{DynamicResource SurfaceAltBrush}">
                                <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" FontSize="24"
                                           Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="这个游戏还没有存档" FontSize="17" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource TextBrush}" Margin="0,15,0,0"/>
                            <TextBlock Text="进入游戏创建一个世界，或者从 zip 备份导入。"
                                       Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            <Button Content="导入存档" Style="{StaticResource SecondaryButton}" Width="110" Height="36"
                                    Margin="0,16,0,0" Click="Import_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border x:Name="NoInstancePanel" Style="{StaticResource Card}" Padding="34" VerticalAlignment="Top"
                    Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" Margin="0,50">
                    <TextBlock Text="先选择一个游戏" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="存档位于每个游戏自己的 saves 目录中，选择游戏后就能查看和备份。"
                               Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                </StackPanel>
            </Border>

            <Grid x:Name="BusyOverlay" Visibility="Collapsed" Background="{DynamicResource OverlayBrush}">
                <Border Width="390" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
                        BorderThickness="1" CornerRadius="16" Padding="24" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock x:Name="BusyTitle" Text="正在处理…" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="BusyDetail" Text="" Style="{StaticResource Muted}" Margin="0,6,0,14"
                                   TextWrapping="Wrap"/>
                        <ProgressBar x:Name="BusyProgress" Height="6" Minimum="0" Maximum="1"/>
                        <TextBlock x:Name="BusyPercent" Text="0%" Style="{StaticResource Caption}" Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="3" Margin="2,11,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="HintText" Text="" Style="{StaticResource Caption}"
                       TextTrimming="CharacterEllipsis" Margin="0,0,18,0"/>
            <TextBlock Grid.Column="1" Text="导出的 zip 可以直接被 Minecraft 服务器或其他工具读取"
                       Style="{StaticResource Caption}"/>
        </Grid>
    </Grid>
</UserControl>
