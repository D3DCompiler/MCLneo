<UserControl x:Class="MCLneo.App.Views.DownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="740" TextElement.Foreground="{DynamicResource TextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="游戏版本" Style="{StaticResource H2}"/>
                <TextBlock Text="从 Mojang 或 BMCLAPI 获取版本清单，自动安装客户端、运行库与资源文件。"
                           Style="{StaticResource Muted}" Margin="1,6,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="下载源" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="SourceBox" Width="160" Height="36" SelectionChanged="SourceBox_SelectionChanged"/>
                <Button Content="刷新" Style="{StaticResource SecondaryButton}" Width="56" Height="36"
                        Margin="8,0,0,0" FontSize="11" Padding="0" ToolTip="刷新版本清单" Click="Refresh_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid>
                    <Grid>
                        <TextBox x:Name="SearchBox" Height="36" Padding="10,7" FontSize="12"
                                 TextChanged="SearchBox_TextChanged" ToolTip="搜索版本号，例如 1.21"/>
                        <TextBlock Text="搜索版本号…" Style="{StaticResource Caption}" Margin="12,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource EmptyStringToVisibility}}"/>
                    </Grid>
                </Grid>
                <CheckBox x:Name="SnapshotCheck" Grid.Column="1" Content="包含快照" Margin="18,0,0,0"
                          VerticalAlignment="Center" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                <TextBlock x:Name="CountText" Grid.Column="2" Text="" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" Margin="20,0,4,0"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <ListBox x:Name="VersionList" Margin="0,0,2,0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardHover}" Padding="17,13" Margin="0,0,0,9" CornerRadius="13">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource SurfaceAltBrush}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="17"
                                               Foreground="{DynamicResource BlueBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="11,0,16,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Id}" FontSize="15" FontWeight="SemiBold"/>
                                        <Border Style="{StaticResource TagBorder}" Margin="9,0,0,0" Padding="7,2">
                                            <TextBlock Text="{Binding Type}" FontSize="9" Foreground="{DynamicResource MutedBrush}"/>
                                        </Border>
                                        <Border Style="{StaticResource AccentTagBorder}" Margin="5,0,0,0" Padding="7,2"
                                                Visibility="{Binding IsLatestRelease, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="最新正式版" FontSize="9" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ReleaseTime, StringFormat='发布于 {0:yyyy-MM-dd HH:mm}'}"
                                               Style="{StaticResource Caption}" Margin="0,5,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="安装" Style="{StaticResource SmallPrimaryButton}"
                                        Width="70" Height="34" Padding="0" Tag="{Binding}" Click="Install_Click"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border x:Name="LoadingPanel" Style="{StaticResource Card}" VerticalAlignment="Top" Padding="30"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="正在读取版本清单…" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="首次读取需要几秒钟，之后的列表会使用本地缓存。"
                               Style="{StaticResource Muted}" Margin="0,6,0,14"/>
                    <ProgressBar IsIndeterminate="True" Height="5"/>
                </StackPanel>
            </Border>

            <Border x:Name="ErrorPanel" Style="{StaticResource Card}" VerticalAlignment="Top" Padding="22"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="版本清单读取失败" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource DangerBrush}"/>
                    <TextBlock x:Name="ErrorText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                    <Button Content="重试" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                            Padding="15,7" Click="Refresh_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="2,12,0,0">
            <TextBlock Text="安装时会自动选择与原版版本匹配的 Java；如果本机没有，会从 Eclipse Adoptium 下载 JRE。"
                       Style="{StaticResource Caption}"/>
            <TextBlock Text="Forge / NeoForge 将在下一里程碑接入" Style="{StaticResource Caption}"
                       HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</UserControl>
