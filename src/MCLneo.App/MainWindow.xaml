<Window x:Class="MCLneo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="MCLneo" Width="1280" Height="820" MinWidth="1080" MinHeight="680"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        AllowsTransparency="True" Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Closing="Window_Closing" SourceInitialized="Window_SourceInitialized"
        StateChanged="Window_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" NonClientFrameEdges="None" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="WindowRoot" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="0" CornerRadius="10" ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Compact navigation rail -->
            <Border x:Name="SidebarRoot" Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="78"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Button x:Name="LogoMark" Grid.Row="0" Style="{StaticResource BareButton}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Click="Logo_Click"
                            ToolTip="MCLneo · 点五下试试">
                        <StackPanel>
                            <Border Width="44" Height="44" CornerRadius="13"
                                    Background="{DynamicResource AccentGradientBrush}" HorizontalAlignment="Center">
                                <TextBlock Text="M" FontFamily="{StaticResource DisplayFont}" FontSize="22"
                                           FontWeight="SemiBold" Foreground="{DynamicResource AccentInkBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                            </Border>
                            <TextBlock Text="MCLneo" FontFamily="{StaticResource DisplayFont}" FontSize="9"
                                       Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Row="1" Margin="10,2,10,0">
                        <RadioButton x:Name="NavHome" Style="{StaticResource RailNavButton}" Tag="home"
                                     Checked="Nav_Checked" ToolTip="主页">
                            <StackPanel>
                                <TextBlock Text="&#xE80F;" Style="{StaticResource IconGlyph}" FontSize="17"/>
                                <TextBlock Text="主页" FontSize="8.5" Margin="0,3,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavInstances" Style="{StaticResource RailNavButton}" Tag="instances"
                                     Checked="Nav_Checked" ToolTip="实例管理">
                            <StackPanel>
                                <TextBlock Text="&#xE8B7;" Style="{StaticResource IconGlyph}" FontSize="17"/>
                                <TextBlock Text="实例" FontSize="8.5" Margin="0,3,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavDownload" Style="{StaticResource RailNavButton}" Tag="download"
                                     Checked="Nav_Checked" ToolTip="下载中心">
                            <StackPanel>
                                <TextBlock Text="&#xE896;" Style="{StaticResource IconGlyph}" FontSize="17"/>
                                <TextBlock Text="下载" FontSize="8.5" Margin="0,3,0,0"/>
                            </StackPanel>
                        </RadioButton>

                        <Border Height="1" Margin="18,8" Background="{DynamicResource BorderBrush}"/>

                        <RadioButton x:Name="NavModpacks" Style="{StaticResource RailNavButton}" Tag="modpacks"
                                     Checked="Nav_Checked" ToolTip="整合包">
                            <StackPanel>
                                <Viewbox Width="18" Height="18" HorizontalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                              StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Data="M5,8 H19 V20 H5 Z M8,8 V5 H16 V8 M8,12 H16"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="整合包" FontSize="8.5" Margin="0,3,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavMods" Style="{StaticResource RailNavButton}" Tag="mods"
                                     Checked="Nav_Checked" ToolTip="模组与资源">
                            <StackPanel>
                                <TextBlock Text="&#xE8F1;" Style="{StaticResource IconGlyph}" FontSize="17"/>
                                <TextBlock Text="模组" FontSize="8.5" Margin="0,3,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavSaves" Style="{StaticResource RailNavButton}" Tag="saves"
                                     Checked="Nav_Checked" ToolTip="存档管理">
                            <StackPanel>
                                <TextBlock Text="&#xE74E;" Style="{StaticResource IconGlyph}" FontSize="17"/>
                                <TextBlock Text="存档" FontSize="8.5" Margin="0,3,0,0"/>
                            </StackPanel>
                        </RadioButton>

                        <Border Height="1" Margin="18,8" Background="{DynamicResource BorderBrush}"/>

                        <RadioButton x:Name="NavRoom" Style="{StaticResource RailNavButton}" Tag="room"
                                     Checked="Nav_Checked" ToolTip="联机房间">
                            <StackPanel>
                                <TextBlock Text="&#xE716;" Style="{StaticResource IconGlyph}" FontSize="17"/>
                                <TextBlock Text="联机" FontSize="8.5" Margin="0,3,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavServers" Style="{StaticResource RailNavButton}" Tag="servers"
                                     Checked="Nav_Checked" ToolTip="服务器">
                            <StackPanel>
                                <Viewbox Width="18" Height="18" HorizontalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                              StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Data="M4,5 H20 V11 H4 Z M4,13 H20 V19 H4 Z M7,8 H7.2 M7,16 H7.2"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="服务器" FontSize="8.5" Margin="0,3,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="10,0,10,12">
                        <RadioButton x:Name="NavSettings" Style="{StaticResource RailNavButton}" Tag="settings"
                                     Checked="Nav_Checked" ToolTip="设置">
                            <StackPanel>
                                <TextBlock Text="&#xE713;" Style="{StaticResource IconGlyph}" FontSize="17"/>
                                <TextBlock Text="设置" FontSize="8.5" Margin="0,3,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Grid>
            </Border>
            <!-- Main area -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                        Background="{DynamicResource TitleBarBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="24,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="PageTitleText" Text="主页" FontFamily="{StaticResource DisplayFont}"
                                       FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock x:Name="PageSubtitleText" Text="欢迎回来" FontSize="11.5" Margin="0,2,0,0"
                                       Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="GameRunningChip" Style="{StaticResource BareButton}" Visibility="Collapsed" Cursor="Hand"
                                    Click="ShowLaunchOverlay_Click" Background="Transparent" BorderThickness="0"
                                    Padding="0" Margin="0,0,10,0">
                                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="10,5">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="游戏运行中" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Button>

                            <Button x:Name="ThemeToggleButton" Style="{StaticResource GhostButton}" Padding="9,7"
                                    Margin="0,0,8,0" Click="ThemeToggle_Click" ToolTip="切换浅色/深色模式">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="ThemeGlyph" Text="&#xE708;" FontFamily="{StaticResource IconFont}"
                                               FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ThemeLabel" Text="深色" FontSize="11" Margin="6,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="AccountButton" Style="{StaticResource BareButton}" Cursor="Hand"
                                    Click="AccountChip_Click" Background="Transparent"
                                    BorderThickness="0" Padding="0" Margin="0,0,10,0">
                                <Border BorderThickness="1" CornerRadius="999" Padding="6,4,13,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="26" Height="26" CornerRadius="999" Background="{DynamicResource AccentSoftBrush}">
                                            <TextBlock Text="{Binding PlayerInitial}" FontSize="11" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PlayerName}" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}" MaxWidth="112"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding AccountSubtitle}" FontSize="8.5"
                                                       Foreground="{DynamicResource FaintBrush}" MaxWidth="112"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Button>

                            <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="最小化"
                                    Click="Minimize_Click"/>
                            <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                                    ToolTip="最大化" Click="Maximize_Click" Margin="2,0"/>
                            <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" ToolTip="关闭"
                                    Click="Close_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" ClipToBounds="True">
                    <Ellipse Width="620" Height="620" Fill="{DynamicResource AccentSoftBrush}" Opacity="0.34"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-340,-220,0"
                             IsHitTestVisible="False"/>
                    <Ellipse Width="460" Height="460" Fill="{DynamicResource BlueSoftBrush}" Opacity="0.22"
                             HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-260,0,0,-300"
                             IsHitTestVisible="False"/>

                    <Grid x:Name="PageTransitionRoot" Margin="28,20,28,22" ClipToBounds="True">
                        <ContentControl x:Name="PageHostOld" Panel.ZIndex="1" IsHitTestVisible="False"
                                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                        <ContentControl x:Name="PageHost" HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"/>
                    </Grid>

                    <!-- Toast -->
                    <Border x:Name="ToastBorder" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Margin="0,0,0,28" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                            CornerRadius="14" Padding="15,10" Visibility="Collapsed" IsHitTestVisible="False">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.45" BlurRadius="20" ShadowDepth="6"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ToastDot" Width="6" Height="6" Fill="{DynamicResource AccentBrush}"
                                     VerticalAlignment="Center" Margin="0,0,9,0"/>
                            <TextBlock x:Name="ToastText" Text="" FontSize="12.5" Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Launch overlay -->
                    <Grid Background="{DynamicResource OverlayBrush}" Visibility="{Binding ShowLaunchOverlay, Converter={StaticResource BoolToVisibility}}">
                        <Border Width="470" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
                                BorderThickness="1" CornerRadius="18" Padding="26" VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="40" ShadowDepth="12"/>
                            </Border.Effect>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                    <Border Width="44" Height="44" CornerRadius="13" Background="{DynamicResource AccentSoftBrush}">
                                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LaunchTitle}" FontSize="17" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="{Binding LaunchDetail}" Style="{StaticResource Muted}"
                                                   TextWrapping="Wrap" MaxWidth="340" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <ProgressBar x:Name="LaunchProgressBar" Minimum="0" Maximum="1" Height="6"/>
                                <Grid Margin="0,7,0,0">
                                    <TextBlock Text="{Binding LaunchFraction, Converter={StaticResource Percent}}"
                                               Style="{StaticResource Caption}"/>
                                    <TextBlock Text="启动进度" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                                </Grid>

                                <Border Visibility="{Binding HasLaunchError, Converter={StaticResource BoolToVisibility}}"
                                        Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerBorderBrush}" BorderThickness="1"
                                        CornerRadius="12" Padding="12" Margin="0,16,0,0" MaxHeight="140">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <TextBlock Text="{Binding LaunchError}" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="10.5" Foreground="{DynamicResource DangerBrush}"
                                                   TextWrapping="Wrap"/>
                                    </ScrollViewer>
                                </Border>

                                <Grid Margin="0,20,0,0">
                                    <Button Content="收起" Style="{StaticResource SecondaryButton}" Padding="15,8"
                                            HorizontalAlignment="Left" Click="DismissLaunchOverlay_Click"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="结束游戏" Style="{StaticResource DangerButton}" Padding="15,8"
                                                Visibility="{Binding IsGameRunning, Converter={StaticResource BoolToVisibility}}"
                                                Click="StopGame_Click" Margin="0,0,8,0"/>
                                        <Button Content="关闭" Style="{StaticResource PrimaryButton}" Padding="18,8"
                                                Click="DismissLaunchOverlay_Click"
                                                Visibility="{Binding HasLaunchError, Converter={StaticResource BoolToVisibility}}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <Popup x:Name="AccountPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=AccountButton}"
                   VerticalOffset="8" HorizontalOffset="-168" AllowsTransparency="True" StaysOpen="False"
                   PopupAnimation="Fade">
                <Grid x:Name="AccountMenuPanel" Width="264" RenderTransformOrigin="0.5,0">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="AccountMenuScale" ScaleX="1" ScaleY="1"/>
                    </Grid.RenderTransform>
                    <Border x:Name="AccountGlassBorder" Background="{DynamicResource GlassBrush}"
                            CornerRadius="16" Padding="7" ClipToBounds="True">
                        <Grid>
                        <Border Background="{DynamicResource GlassBrush}" CornerRadius="15"
                                Opacity="0.55" IsHitTestVisible="False"/>
                        <StackPanel>
                            <Grid Margin="9,9,9,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource AccentSoftBrush}">
                                    <TextBlock Text="{Binding PlayerInitial}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PlayerName}" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding AccountSubtitle}" Style="{StaticResource Caption}"
                                               FontSize="9.5" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="6,0"/>
                            <Button Content="账户与皮肤" Style="{StaticResource GhostButton}" Height="36"
                                    HorizontalContentAlignment="Left" Padding="10,0" FontSize="12"
                                    Click="AccountSettings_Click"/>
                            <Button Content="浅色 / 深色" Style="{StaticResource GhostButton}" Height="36"
                                    HorizontalContentAlignment="Left" Padding="10,0" FontSize="12"
                                    Click="AccountTheme_Click"/>
                            <Button Content="检查更新" Style="{StaticResource GhostButton}" Height="36"
                                    HorizontalContentAlignment="Left" Padding="10,0" FontSize="12"
                                    Click="AccountUpdate_Click"/>
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="6,4"/>
                            <Button Content="打开数据目录" Style="{StaticResource GhostButton}" Height="34"
                                    HorizontalContentAlignment="Left" Padding="10,0" FontSize="11.5"
                                    Click="AccountData_Click"/>
                        </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Popup>

            <Canvas x:Name="EasterEggLayer" Grid.ColumnSpan="2" Panel.ZIndex="90"
                    IsHitTestVisible="False" ClipToBounds="True"/>
            <Grid x:Name="ThemeTransitionLayer" Grid.ColumnSpan="2" Panel.ZIndex="100"
                  IsHitTestVisible="False" ClipToBounds="True"/>
        </Grid>
    </Border>
</Window>
