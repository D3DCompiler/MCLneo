<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Paper · light -->
    <SolidColorBrush x:Key="BgBrush" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F0F0F2"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#E8E8EC"/>
    <SolidColorBrush x:Key="InsetBrush" Color="#F4F4F6"/>
    <SolidColorBrush x:Key="InputBrush" Color="#FAFAFB"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#F2F2F4"/>
    <SolidColorBrush x:Key="TitleBarBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E2E2E7"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#C9C9D1"/>
    <SolidColorBrush x:Key="TextBrush" Color="#141417"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#66666E"/>
    <SolidColorBrush x:Key="FaintBrush" Color="#8A8A93"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#2F5BFF"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1F49E8"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E9EDFF"/>
    <SolidColorBrush x:Key="AccentInkBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#C7D3FF"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#C73535"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FBE9E9"/>
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#E7B5B5"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#8A5A00"/>
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#FBF1D9"/>
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#E5D0A0"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#2E7D4F"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#E4F4E9"/>
    <SolidColorBrush x:Key="BlueBrush" Color="#2F5BFF"/>
    <SolidColorBrush x:Key="BlueSoftBrush" Color="#E8EDFF"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="#E4E4E8"/>
    <SolidColorBrush x:Key="NavHoverBrush" Color="#E9E9ED"/>
    <SolidColorBrush x:Key="NavActiveBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#C7D3FF"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="#99141417"/>
    <SolidColorBrush x:Key="HeroLineBrush" Color="#D8D8DF"/>
    <SolidColorBrush x:Key="TagBrush" Color="#F0F0F2"/>
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#F2FFFFFF"/>
    <SolidColorBrush x:Key="GlassHighlightBrush" Color="#F2FFFFFF"/>
    <SolidColorBrush x:Key="GlassBrush" Color="#D9DDE1EA"/>
    <SolidColorBrush x:Key="PopupGlassBrush" Color="#E2E5EC"/>
    <SolidColorBrush x:Key="SidebarGlassBrush" Color="#80F1F1F5"/>
    <LinearGradientBrush x:Key="NavLensBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#B3FFFFFF" Offset="0"/>
        <GradientStop Color="#4DFFFFFF" Offset="0.6"/>
        <GradientStop Color="#1AFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="NavLensBorderBrush" Color="#40FFFFFF"/>
    <RadialGradientBrush x:Key="NavAuroraBrush" GradientOrigin="0.25,0.15" Center="0.25,0.15"
                         RadiusX="1.2" RadiusY="1.2">
        <GradientStop Color="#4D506DFF" Offset="0"/>
        <GradientStop Color="#127A5CFF" Offset="0.55"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="NavLensGlowBrush" GradientOrigin="0.25,0.15" Center="0.25,0.15"
                         RadiusX="0.9" RadiusY="0.9">
        <GradientStop Color="#FFFFFFFF" Offset="0"/>
        <GradientStop Color="#55FFFFFF" Offset="0.55"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="NavLensSheenBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#CCFFFFFF" Offset="0"/>
        <GradientStop Color="#33FFFFFF" Offset="0.46"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassSheenBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#B3FFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="0.52"/>
    </LinearGradientBrush>
    <Color x:Key="ShadowColor">#3340444A</Color>

    <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#F4F6FF" Offset="0.55"/>
        <GradientStop Color="#EDEFF8" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#2F5BFF" Offset="0"/>
        <GradientStop Color="#7A9BFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TitleSheenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#F5F5F7" Offset="1"/>
    </LinearGradientBrush>

    <DrawingBrush x:Key="GridPatternBrush" TileMode="Tile" Viewport="0,0,40,40" ViewportUnits="Absolute"
                  Viewbox="0,0,40,40" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="Transparent">
                <GeometryDrawing.Pen>
                    <Pen Brush="#E4E4E8" Thickness="0.7"/>
                </GeometryDrawing.Pen>
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <LineGeometry StartPoint="0,0" EndPoint="40,0"/>
                        <LineGeometry StartPoint="0,0" EndPoint="0,40"/>
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>
</ResourceDictionary>
