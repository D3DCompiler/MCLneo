<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Ink · dark -->
    <SolidColorBrush x:Key="BgBrush" Color="#050506"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#111113"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#18181B"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#202024"/>
    <SolidColorBrush x:Key="InsetBrush" Color="#0C0C0E"/>
    <SolidColorBrush x:Key="InputBrush" Color="#0C0C0E"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#08080A"/>
    <SolidColorBrush x:Key="TitleBarBrush" Color="#08080A"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#26262B"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#3A3A42"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F4F4F6"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#9C9CA6"/>
    <SolidColorBrush x:Key="FaintBrush" Color="#6B6B75"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#6D8DFF"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#8EA6FF"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#171D2E"/>
    <SolidColorBrush x:Key="AccentInkBrush" Color="#080B18"/>
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#34446E"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF6B6B"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#2A1114"/>
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#5A2429"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F5C451"/>
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#2A2312"/>
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#5A4A1E"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#7BD8A0"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#10241A"/>
    <SolidColorBrush x:Key="BlueBrush" Color="#7BA7FF"/>
    <SolidColorBrush x:Key="BlueSoftBrush" Color="#131B2E"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="#242429"/>
    <SolidColorBrush x:Key="NavHoverBrush" Color="#161619"/>
    <SolidColorBrush x:Key="NavActiveBrush" Color="#1D1D22"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#34446E"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="#CC000000"/>
    <SolidColorBrush x:Key="HeroLineBrush" Color="#32323A"/>
    <SolidColorBrush x:Key="TagBrush" Color="#18181B"/>
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="GlassHighlightBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="GlassBrush" Color="#D92A2A35"/>
    <SolidColorBrush x:Key="PopupGlassBrush" Color="#2A2A35"/>
    <SolidColorBrush x:Key="SidebarGlassBrush" Color="#660A0A0E"/>
    <LinearGradientBrush x:Key="NavLensBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#593E3E55" Offset="0"/>
        <GradientStop Color="#1A242430" Offset="0.55"/>
        <GradientStop Color="#0DFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="NavLensBorderBrush" Color="#26FFFFFF"/>
    <RadialGradientBrush x:Key="NavAuroraBrush" GradientOrigin="0.25,0.15" Center="0.25,0.15"
                         RadiusX="1.2" RadiusY="1.2">
        <GradientStop Color="#4D506DFF" Offset="0"/>
        <GradientStop Color="#147A5CFF" Offset="0.55"/>
        <GradientStop Color="#00000000" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="NavLensGlowBrush" GradientOrigin="0.25,0.15" Center="0.25,0.15"
                         RadiusX="0.9" RadiusY="0.9">
        <GradientStop Color="#88FFFFFF" Offset="0"/>
        <GradientStop Color="#18FFFFFF" Offset="0.55"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="NavLensSheenBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2EFFFFFF" Offset="0"/>
        <GradientStop Color="#0AFFFFFF" Offset="0.46"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassSheenBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#33FFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="0.48"/>
    </LinearGradientBrush>
    <Color x:Key="ShadowColor">#000000</Color>

    <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#15151A" Offset="0"/>
        <GradientStop Color="#101014" Offset="0.58"/>
        <GradientStop Color="#0B0B0E" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#6D8DFF" Offset="0"/>
        <GradientStop Color="#A78BFA" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TitleSheenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#111114" Offset="0"/>
        <GradientStop Color="#08080A" Offset="1"/>
    </LinearGradientBrush>

    <DrawingBrush x:Key="GridPatternBrush" TileMode="Tile" Viewport="0,0,40,40" ViewportUnits="Absolute"
                  Viewbox="0,0,40,40" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="Transparent">
                <GeometryDrawing.Pen>
                    <Pen Brush="#242429" Thickness="0.7"/>
                </GeometryDrawing.Pen>
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <LineGeometry StartPoint="0,0" EndPoint="40,0"/>
                        <LineGeometry StartPoint="0,0" EndPoint="0,40"/>
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>
</ResourceDictionary>
